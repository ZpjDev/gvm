#!/usr/bin/env bash

. "$GVM_ROOT/scripts/functions" || return 1

gvm() {
	if [[ -z "${GVM_ROOT:-}" ]]; then
		display_error "GVM_ROOT not set. Try running: \'source \$GVM_ROOT/scripts/gvm\'."
		return 1
	fi

	if [[ ! -d "${GVM_ROOT:-/nonexistent}" ]]; then
		display_error "GVM_ROOT does not exist. Please reinstall GVM."
		return 1
	fi

	# A .git here means this is somebody's work tree rather than an install, so
	# gvm's own files are unversioned and a stray `git clean` in $GVM_ROOT would
	# take them out. Warn once per shell rather than refusing every command: the
	# fix is a reinstall, but nothing here is broken until they run git.
	if [[ -z "${GVM_NO_GIT_BAK:-}" && -d "$GVM_ROOT/.git" && -z "${_gvm_warned_git:-}" ]]; then
		display_warning "$GVM_ROOT is a git work tree, not just an install."
		display_message "gvm keeps its own state here; 'git clean' in this directory would delete it."
		display_message "Reinstall with install.sh to fix this, or set GVM_NO_GIT_BAK=1 to silence it."
		_gvm_warned_git=1
	fi

	mkdir -p "$GVM_ROOT/logs" > /dev/null 2>&1
	mkdir -p "$GVM_ROOT/gos" > /dev/null 2>&1
	mkdir -p "$GVM_ROOT/archive" > /dev/null 2>&1
	mkdir -p "$GVM_ROOT/archive/package" > /dev/null 2>&1
	mkdir -p "$GVM_ROOT/environments" > /dev/null 2>&1

	if [[ "${1:-}" == "use" ]]; then
		. "$GVM_ROOT/scripts/env/use"
		shift
		gvm_use "$@"
	elif [[ "${1:-}" == "applymod" ]]; then
		. "$GVM_ROOT/scripts/env/use"
		. "$GVM_ROOT/scripts/env/applymod"
		shift
		gvm_applymod "$@"
	elif [[ "${1:-}" == "implode" ]]; then
		. "$GVM_ROOT/scripts/env/implode"
		shift
		gvm_implode "$@"
	elif [[ "${1:-}" == "pkgset" ]] && [[ "${2:-}" == "use" ]]; then
		. "$GVM_ROOT/scripts/env/pkgset-use"
		shift
		shift
		gvm_pkgset_use "$@"
	else
		"$GVM_ROOT/bin/gvm" "$@"
	fi
}
